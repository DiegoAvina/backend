APP_NAME=BRAND_NAME
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plataforma_corporativa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Integración con el frontend (Next.js) ───
# Llave compartida servidor-a-servidor para los formularios. Debe coincidir con
# API_SERVICE_KEY del frontend. Genera una con: php -r "echo bin2hex(random_bytes(32));"
# Si queda vacía, la API rechaza todas las escrituras.
FRONTEND_SERVICE_KEY=
# Orígenes del navegador que pueden leer la API pública (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Lecturas por minuto y por IP en la API pública.
API_CONTENT_RATE_LIMIT=300

# Webhook de revalidación: al publicar o editar contenido, Laravel avisa a
# Next.js (POST /api/revalidate) con una firma HMAC. Vacíos = desactivado.
# El secreto debe coincidir con REVALIDATE_SECRET del frontend.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
FRONTEND_REVALIDATE_SECRET=

# ─── Notificaciones comerciales (desactivadas hasta contar con SMTP y autorización) ───
# Destinatarios de respaldo; los del panel (Configuración → Notificaciones) tienen prioridad.
LEAD_NOTIFICATIONS_ENABLED=false
COMMERCIAL_NOTIFICATION_EMAILS=
